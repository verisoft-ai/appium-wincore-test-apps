# Copy to sap/.env and adjust.

# Which ABAP image docker-compose uses.
#   - Community prebuilt (archives baked in, no SAP login needed to obtain):
#       SAP_ABAP_IMAGE=yoraco/sap-dev-edition-7.52-sp04
#   - Your own build from official SAP archives (see README "Build route"):
#       SAP_ABAP_IMAGE=nwabap:7.52
SAP_ABAP_IMAGE=yoraco/sap-dev-edition-7.52-sp04
